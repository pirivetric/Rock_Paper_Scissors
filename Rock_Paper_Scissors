import random

operation = "paper, rock, scissors"
rock = "rock"
paper = "paper"
scissors = "scissors"
user_score = 0
computer_score = 0
while True:
    computer = random.choice([rock, paper, scissors])
    user = input("Choose Rock, Paper or Scissors:").lower()
    print(f"Computer chose:{computer}")
    if computer == user:
        print("Tie")
    elif computer == rock and user == scissors:
        print("Computer won")
        computer_score += 1
    elif computer == scissors and user == rock:
        print("User won")
        user_score += 1
    elif computer == rock and user == paper:
        print("User won")
        user_score += 1
    elif computer == paper and user == rock:
        print("Computer won")
        computer_score += 1
    elif computer == scissors and user == paper:
        print("Computer won")
        computer_score += 1
    elif computer == paper and user == scissors:
        print("User won")
        user_score += 1
    else:
        user not in operation
        print("You cant choose that")
        continue
    print("-------------------------------")
    print(f"Users score is:{user_score}")
    print(f"Computers score is:{computer_score}")
    print("-------------------------------")